<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BIO DATA</title>
    
</head>
<body>
    <style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 40px 20px;
        min-height: 100vh;

        font-family: Arial, sans-serif;

        background-color: #8B5A2B;
        background-image:
            linear-gradient(
                rgba(255, 255, 255, 0.08) 1px,
                transparent 1px
            ),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.05) 1px,
                transparent 1px
            );

        color: #222;
    }

    form {
        width: 100%;
        max-width: 500px;
        margin: auto;

        background-color: #fff;

        padding: 35px 40px;

        border: 3px solid #1f1f1f;
        border-radius: 12px;

        box-shadow:
            8px 8px 0px #3f2817,
            0 12px 25px rgba(0, 0, 0, 0.25);
    }

    form::before {
        content: "BIO-DATA";
        display: block;

        text-align: center;

        font-size: 30px;
        font-weight: bold;
        letter-spacing: 4px;

        color: #5C3A21;

        padding-bottom: 15px;
        margin-bottom: 25px;

        border-bottom: 3px double #5C3A21;
    }

    input {
        width: 100%;
        height: 48px;

        margin-bottom: 16px;
        padding: 0 15px;

        font-size: 15px;

        background-color: #fff;

        border: 2px solid #222;
        border-radius: 6px;

        outline: none;

        transition: 0.2s;
    }

    input::placeholder {
        color: #777;
    }

    input:focus {
        border-color: #8B5A2B;

        box-shadow: 0 0 0 3px rgba(139, 90, 43, 0.15);
    }

    input:hover {
        background-color: #faf7f3;
    }

    button {
        width: 100%;
        height: 50px;

        margin-top: 5px;

        background-color: #8B5A2B;
        color: white;

        font-size: 17px;
        font-weight: bold;
        letter-spacing: 1px;

        border: 2px solid #222;
        border-radius: 6px;

        cursor: pointer;

        box-shadow: 3px 3px 0 #222;

        transition: 0.2s;
    }

    button:hover {
        background-color: #6F451F;
    }

    button:active {
        transform: translate(2px, 2px);
        box-shadow: 1px 1px 0 #222;
    }

    br {
        display: none;
    }

    @media (max-width: 550px) {
        body {
            padding: 20px 12px;
        }

        form {
            padding: 25px 20px;
        }

        form::before {
            font-size: 24px;
        }
    }
</style>

    <form action="/biodata" method="POST">
        <input type="text" name="ln"
        placeholder="E̲n̲t̲e̲r̲ ̲L̲a̲s̲t̲n̲a̲m̲e̲" required>
        <br>
        <input type="text" name="fn"
        placeholder="E̲n̲t̲e̲r̲ ̲F̲i̲r̲s̲t̲n̲a̲m̲e̲" required>
        <br>
        <input type="text" name="mn"
        placeholder="E̲n̲t̲e̲r̲ ̲M̲i̲d̲d̲l̲e̲n̲a̲m̲e̲" required>
        <br>
        <input type="text" name="em"
        placeholder="Enter Email" required>
        <br>
        <input type="text" name="pn"
        placeholder="E̲n̲t̲e̲r̲ ̲P̲h̲o̲n̲e̲n̲u̲m̲b̲e̲r̲" required>
        <br>
        <input type="text" name="age"
        placeholder="E̲n̲t̲e̲r̲ ̲A̲g̲e̲" required>
        <br>
        <input type="text" name="cs"
        placeholder="E̲n̲t̲e̲r̲ ̲C̲o̲u̲r̲s̲e̲" required>
        <br>
        <input type="text" name="sc"
        placeholder="E̲n̲t̲e̲r̲ ̲S̲e̲c̲t̲i̲o̲n̲" required>
        <br>
        <input type="text" name="gn"
        placeholder="E̲n̲t̲e̲r̲ ̲G̲e̲n̲d̲e̲r̲" required>
        <br>
        <button type="submmit"Apply</button>
</body>
</html>